# Phase 5d-2 local handler + acceptance (gitignored — copy to .env.5d2)
# Get Signing Secret: api.slack.com/apps → ILDS Notifier → Basic Information

SLACK_SIGNING_SECRET=
# GITHUB_TOKEN is resolved by the script (gh auth token). Optional override:
# GITHUB_TOKEN=ghp_...
# Optional — for local notify without Actions:
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
