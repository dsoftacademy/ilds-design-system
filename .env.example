# Copy to `.env` in this folder (gitignored):
#   cp .env.example .env
# Then paste your Figma personal access token (Figma → Settings → Security).
# Publish Code Connect: npm run code-connect:publish
#
# Token sync (Phase 6b): requires file_variables:read scope on the token.
# Code Connect uses different scopes — you may need a separate token.
# Also add as GitHub secret:
#   GitHub → Settings → Secrets and variables → Actions → New repository secret
#   Name: FIGMA_ACCESS_TOKEN
#   Value: <personal access token with file_variables:read>

FIGMA_ACCESS_TOKEN=
