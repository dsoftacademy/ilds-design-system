{
  "name": "ilds-design-system",
  "version": "1.0.0",
  "description": "ICICI Lombard Design System",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "code-connect:publish": "dotenv -e .env -- npx figma connect publish",
    "build:tokens": "node style-dictionary.config.mjs",
    "sync:tokens": "node tool/sync_figma_tokens.mjs",
    "verify:tokens": "node tool/verify_token_exports.mjs",
    "verify:phase4b": "node tool/verify_phase4b.mjs",
    "verify:parity": "node tool/verify_cross_platform_parity.mjs",
    "propose:change": "node tool/propose_change.mjs",
    "notify:pr-slack": "node tool/notify_pr_slack.mjs",
    "router:classify": "node tool/review_router.mjs classify",
    "router:auto-merge": "node tool/review_router.mjs auto-merge",
    "test:router": "node --test tool/review_router_classify.test.mjs tool/review_router.test.mjs",
    "test:integrity": "node --test tool/control_plane_integrity.test.mjs",
    "test:adversary": "node --test tool/adversary/machine_checks.test.mjs",
    "adversary:review": "node tool/adversary/run_review.mjs",
    "agent-org:run": "node tool/agent-org/run.mjs",
    "slack:interactivity-server": "node tool/slack_interactivity_server.mjs",
    "storybook": "npm run storybook --prefix web",
    "build:storybook": "npm run build-storybook --prefix web",
    "test:web": "npm run build-storybook --prefix web && npm run test:parity --prefix web"
  },
  "dependencies": {
    "@figma/code-connect": "^1.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.29",
    "@anthropic-ai/sdk": "^0.39.0",
    "dotenv-cli": "^8.0.0",
    "style-dictionary": "^4.4.0"
  }
}
